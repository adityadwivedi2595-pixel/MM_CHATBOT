# Backend Environment Variables
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Google Gemini API Key (Multimodal Vision, Text & Embeddings)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: OpenAI API Key (Dual Provider Support)
OPENAI_API_KEY=

# Storage Directory for Documents and Media
UPLOAD_DIR=storage/uploads
GENERATED_DIR=storage/generated

# Database Configuration (PostgreSQL + pgvector or SQLite Fallback)
# Example: postgresql+asyncpg://postgres:postgres@localhost:5432/mm_chatbot
DATABASE_URL=sqlite+aiosqlite:///./storage/chatbot.db
